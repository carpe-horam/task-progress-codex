{
  "description": "Task Progress startup and turn planning reminders.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/task_progress_hook.py\"",
            "timeout": 2,
            "statusMessage": "Preparing Task Progress guidance"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/task_progress_hook.py\"",
            "timeout": 2,
            "statusMessage": "Checking Task Progress guidance"
          }
        ]
      }
    ]
  }
}
